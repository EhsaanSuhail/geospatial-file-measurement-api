# Copy to `.env` and adjust. `.env` is git-ignored; never commit real credentials.
# Docker Compose falls back to the development defaults below when `.env` is absent.

# --- PostgreSQL container (docker compose) ---
POSTGRES_USER=geomeasure
POSTGRES_PASSWORD=geomeasure
POSTGRES_DB=geomeasure
POSTGRES_HOST_PORT=5432
API_PORT=8000

# --- Application ---
# Used when running the API outside Docker; inside Compose it is derived from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://geomeasure:geomeasure@127.0.0.1:5432/geomeasure
LOG_LEVEL=INFO

# Upload limits (see the README).
MAX_UPLOAD_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=250
MAX_ARCHIVE_MEMBERS=100
MAX_FEATURE_COUNT=50000

# --- Tests ---
# Defaults to DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=postgresql+psycopg://geomeasure:geomeasure@127.0.0.1:5432/geomeasure_test
