<?xml version="1.0" encoding="UTF-8"?>
<!-- Sample drone-survey deliverable near Bengaluru (UTM zone 43N). Coordinates are WGS 84. -->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Whitefield site survey</name>
    <Folder>
      <name>Site boundary</name>
      <Placemark>
        <name>Survey boundary</name>
        <description>Boundary agreed with the client on 2026-09-14</description>
        <ExtendedData>
          <Data name="site_code"><value>WFD-07</value></Data>
          <Data name="surveyor"><value>Field team B</value></Data>
        </ExtendedData>
        <Polygon>
          <outerBoundaryIs><LinearRing><coordinates>
            77.7480,12.9690 77.7520,12.9690 77.7520,12.9725 77.7480,12.9725 77.7480,12.9690
          </coordinates></LinearRing></outerBoundaryIs>
        </Polygon>
      </Placemark>
    </Folder>
    <Folder>
      <name>Stockpiles</name>
      <Placemark>
        <name>Aggregate stockpiles</name>
        <ExtendedData><Data name="material"><value>20 mm aggregate</value></Data></ExtendedData>
        <MultiGeometry>
          <Polygon><outerBoundaryIs><LinearRing><coordinates>
            77.7490,12.9700 77.7494,12.9700 77.7494,12.9703 77.7490,12.9703 77.7490,12.9700
          </coordinates></LinearRing></outerBoundaryIs></Polygon>
          <Polygon><outerBoundaryIs><LinearRing><coordinates>
            77.7500,12.9700 77.7503,12.9700 77.7503,12.9704 77.7500,12.9704 77.7500,12.9700
          </coordinates></LinearRing></outerBoundaryIs></Polygon>
        </MultiGeometry>
      </Placemark>
    </Folder>
    <Folder>
      <name>Haul roads</name>
      <Placemark>
        <name>Main haul road</name>
        <LineString><coordinates>
          77.7482,12.9692,905 77.7500,12.9695,906 77.7515,12.9710,909 77.7518,12.9722,911
        </coordinates></LineString>
      </Placemark>
    </Folder>
    <Folder>
      <name>Ground control points</name>
      <Placemark><name>GCP-01</name><Point><coordinates>77.7481,12.9691,904.2</coordinates></Point></Placemark>
      <Placemark><name>GCP-02</name><Point><coordinates>77.7519,12.9724,910.8</coordinates></Point></Placemark>
    </Folder>
    <Folder>
      <name>Annotations</name>
      <Placemark>
        <name>Site office and access path</name>
        <MultiGeometry>
          <Point><coordinates>77.7485,12.9720</coordinates></Point>
          <LineString><coordinates>77.7485,12.9720 77.7490,12.9715</coordinates></LineString>
        </MultiGeometry>
      </Placemark>
    </Folder>
  </Document>
</kml>
